# Copy to .env and fill in. Never commit .env.

# Groq: https://console.groq.com/keys (free tier)
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# Guardrail policy models (output safety check, input blocked-topics check). Same policy prompts
# and JSON output work with openai/gpt-oss-safeguard-20b, but its free tier is limited to
# 3 RPM / 2K TPM (requests over 2K tokens fail with HTTP 413), so gpt-oss-20b is the default.
GROQ_SAFETY_MODEL=openai/gpt-oss-20b
GROQ_TOPIC_MODEL=openai/gpt-oss-20b
# DeepEval judge (Phase 10): separate rate limit and a different model family from the generator
GROQ_JUDGE_MODEL=qwen/qwen3.8-27b
# reasoning_effort for the judge only ("none" for qwen3.8); empty = not sent
GROQ_JUDGE_REASONING_EFFORT=none
# low | medium | high for gpt-oss; leave empty for models without reasoning_effort
GROQ_REASONING_EFFORT=low

# LlamaParse: https://cloud.llamaindex.ai (free tier) - needed from Phase 2
LLAMA_CLOUD_API_KEY=
# v2 tiers: fast | cost_effective | agentic | agentic_plus ("fast" has no markdown output)
LLAMA_PARSE_TIER=cost_effective

# Qdrant (local Docker)
QDRANT_URL=http://localhost:6333

# Embeddings (local, via FastEmbed)
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
# Added to questions (not documents) before embedding; bge v1.5 retrieval instruction. Empty = off.
EMBED_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
# Local cross-encoder that re-scores retrieved chunks (FastEmbed TextCrossEncoder). Changing it
# changes the score scale: re-calibrate similarity_cutoff with scripts.retrieval_check.
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Sparse model for hybrid search (projects with hybrid=True)
SPARSE_MODEL=Qdrant/bm25

# Optional: NCBI key raises PubMed rate limits
NCBI_API_KEY=

# Largest PDF accepted by source uploads (Phase 5)
MAX_UPLOAD_MB=25

# Guardrails (Phase 6): closed = block when a guard call fails, open = let it through
GUARD_FAIL_MODE=closed
# Llama Prompt Guard 2 score above which a question is blocked (calibrate with scripts.guard_check)
PROMPT_GUARD_THRESHOLD=0.5
MAX_QUESTION_CHARS=2000

# Project served by the FastAPI app (Phase 7)
API_PROJECT=medrag

# FastAPI base URL used by the Streamlit UI (Phase 8)
API_URL=http://localhost:8000
