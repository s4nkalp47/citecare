# Copy to .env and fill in. Never commit .env.

# Groq: https://console.groq.com/keys (free tier)
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GROQ_SAFETY_MODEL=openai/gpt-oss-safeguard-20b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b

# LlamaParse: https://cloud.llamaindex.ai (free tier) - needed from Phase 2
LLAMA_CLOUD_API_KEY=
# v2 tiers: fast | cost_effective | agentic | agentic_plus ("fast" has no markdown output)
LLAMA_PARSE_TIER=cost_effective

# Qdrant (local Docker)
QDRANT_URL=http://localhost:6333

# Embeddings (local, via FastEmbed)
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# Optional: NCBI key raises PubMed rate limits
NCBI_API_KEY=
